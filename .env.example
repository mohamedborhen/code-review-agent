GITHUB_WEBHOOK_SECRET=your-secret-here
CRG_SERVER_URL=http://localhost:5555/mcp
WORKSPACE_ROOT=./data/workspaces
METADATA_DB_PATH=./data/phase1_metadata.db
# Phase 2 — required, no default. LLM model spec for the whole multi-agent system
# in `provider:model` form; resolved via langchain's init_chat_model, which
# dispatches by provider prefix. Only the provider matching this value needs its
# API key set (see the provider keys below). Examples:
#   groq:llama-3.3-70b-versatile
#   openrouter:anthropic/claude-sonnet-4-5
#   google_genai:gemini-2.5-pro
#   openai:gpt-5.5
#   anthropic:claude-sonnet-4-6
REVIEW_MODEL=
# Phase 2 — LLM provider API keys. Optional; only the one whose provider matches
# REVIEW_MODEL is required at runtime.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# For langchain-ollama models (no API key): OLLAMA_HOST=http://localhost:11434
# Phase 2 — GitHub PAT for the GitHub MCP server (Authorization: Bearer), read-only scopes
GITHUB_PAT=
# Phase 2 — optional; omit or leave empty for public rate-limited Context7 access
CONTEXT7_API_KEY=
# Phase 2 — mcp-atlassian endpoint. Docker-compose overrides to http://mcp-atlassian:9000/mcp
ATLASSIAN_MCP_URL=http://127.0.0.1:9000/mcp
# Phase 2 — mcp-atlassian auth; read by the mcp-atlassian process itself (uvx mcp-atlassian or the compose service), never via client headers
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# Phase 2 — mcp-atlassian server-side behavior, read by the mcp-atlassian process (not our app).
# Read-only enforced server-side; ALLOW_GLOBAL_CRED_FALLBACK needed since v0.23.0 for clients
# that don't send Atlassian headers (ours) — this is mcp-atlassian's single-user global-fallback
# gate (any server-side auth type, not mTLS-only); TOOLSETS=all keeps the full toolset available;
# ENABLED_TOOLS is an exact-name allowlist enforced at listing AND call time so review agents
# can only ever reach these three read tools (no jira_create_issue / delete / transition,
# no confluence_create_page / update / delete).
READ_ONLY_MODE=true
ALLOW_GLOBAL_CRED_FALLBACK=true
TOOLSETS=all
ENABLED_TOOLS=jira_get_issue,confluence_search,confluence_get_page
